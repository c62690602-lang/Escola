# Local development only. Replace credentials in deployed environments.
DATABASE_URL=postgresql://nexo:nexo_local_development@127.0.0.1:5432/nexo
DEMO_MODE=true
# Required only when running db:seed. Choose a strong local password.
DEMO_PASSWORD=
# Required behind a reverse proxy in deployment. Example: https://nexo.your-domain.example
# APP_ORIGIN=
# Isolated hosted demonstration: disable local-only recovery delivery.
# PUBLIC_DEMO=true
# MFA: random stable secret, at least 32 characters; never commit the value.
MFA_ENCRYPTION_KEY=
# Require enrollment before administrators can access operational routes.
REQUIRE_ADMIN_MFA=false
