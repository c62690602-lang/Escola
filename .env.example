# URL pública canônica, necessária antes de publicar
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Endereço HTTPS real do sistema; vazio mantém acesso indisponível
NEXT_PUBLIC_NEXO_URL=
# PostgreSQL persistente em produção (Vercel). Nunca usar SQLite no filesystem efêmero.
DATABASE_URL=
# Somente desenvolvimento: SQLite local, permissões restritas
NEXO_DATA_DIR=.data
# Gere uma senha exclusiva com no mínimo 16 caracteres; nunca usar NEXT_PUBLIC_
ADMIN_PASSWORD=
# Opcional: número internacional só com dígitos, confirmado pela equipe
NEXT_PUBLIC_WHATSAPP_NUMBER=
